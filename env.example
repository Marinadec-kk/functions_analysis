# ========================================
# CORE SETTINGS
# ========================================

# Input folder containing .docx documents to process
INPUT_FOLDER=input_documents

# Output Excel file for analysis results  
OUTPUT_EXCEL=data/analysis_results.xlsx

# Output folder for generated markdown documentation
OUTPUT_MARKDOWN_FOLDER=data/markdown_output

# Reference files (should point to your existing data)
SPHERES_FILE=files/SPHERES.xlsx
UNIVERSAL_FUNCTIONS_JSON=files/universal_functions.json

# ========================================
# AI CONFIGURATION
# ========================================

# AI mode: 'online' for OpenAI API, 'local' for local server
AI_MODE=local

# OpenAI API key (required for online mode)
OPENAI_API_KEY=<if online mode>

# AI model for chat completions
AI_MODEL=gemma-3-27b-it

# Embedding server (for local models)
EMBEDDING_SERVER=http://localhost:7010
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2

USE_LOCAL_EMBEDDINGS=true

# Temperature (0.0-2.0): Controls randomness. Higher = more creative, Lower = more deterministic
# Recommended: 0.3-0.7 for classification tasks, 1.0 for balanced responses
AI_TEMPERATURE=1.0

# Max tokens for completion
# Recommended: 2000-4000 for government function analysis
AI_MAX_TOKENS=4000

# ========================================
# PROCESSING PARAMETERS
# ========================================

# Similarity threshold for collision detection (0.0-1.0)
SIMILARITY_THRESHOLD=0.5

# Universal similarity threshold for suggestions (0.0-1.0)  
UNIVERSAL_SIMILARITY_THRESHOLD=0.75

# # Performance settings
 EMBEDDING_WORKERS=8
 AI_WORKERS=30
 BATCH_SIZE=64   

# ========================================
# LOGGING
# ========================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
