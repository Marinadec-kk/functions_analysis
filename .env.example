# Core settings
INPUT_FOLDER=/data/input_documents
OUTPUT_EXCEL=/data/analysis_results.xlsx
OUTPUT_MARKDOWN_FOLDER=/data/markdown_output
SPHERES_FILE=/data/spheres_reference.xlsx
UNIVERSAL_FUNCTIONS_JSON=/data/universal_functions.json

# AI Configuration
AI_MODE='Онлайн'  # online, local, custom
OPENAI_API_KEY=${OPENAI_API_KEY}
AI_MODEL=gpt-4o-mini
EMBEDDING_SERVER=http://localhost:1234
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B-GGUF

# Processing Parameters
SIMILARITY_THRESHOLD=0.5
UNIVERSAL_SIMILARITY_THRESHOLD=0.75
EMBEDDING_WORKERS=8
AI_WORKERS=30
BATCH_SIZE=64

# Prompt Files (relative to project root)
PROMPT_DOCUMENT_PARSER_EXTRACT=prompts/document_parser/extract_full_name.txt
PROMPT_FUNCTION_CLASSIFIER_INITIAL=prompts/function_classifier/classify_initial.txt
PROMPT_FUNCTION_CLASSIFIER_REFINEMENT=prompts/function_classifier/classify_refinement.txt
PROMPT_FUNCTION_CLASSIFIER_VERIFY=prompts/function_classifier/verify_type.txt
PROMPT_FUNCTION_CLASSIFIER_ARBITRATE=prompts/function_classifier/arbitrate_dispute.txt
PROMPT_SPHERE_CLASSIFIER=prompts/sphere_classifier/classify_sphere.txt
PROMPT_COLLISION_DETECTOR=prompts/collision_detector/verify_collision.txt

# Logging
LOG_LEVEL=INFO
