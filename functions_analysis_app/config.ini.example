; config.ini.example
; This file provides an example of how to configure application settings.
; Values in .env (environment variables) will override these settings,
; and these settings will override hardcoded defaults in config.py.

[API]
; Base URL for AI services.
; AI_API_BASE_URL = http://localhost:8000/api

[Paths]
; Default input directory for documents to be analyzed.
DEFAULT_INPUT_DOCS_DIR = input_documents

; Default output directory for analysis results.
DEFAULT_OUTPUT_DIR = output_results

; Path for application log file.
LOG_FILE_PATH = app_logs.log

[Models]
; Name of the model used for classification tasks.
CLASSIFICATION_MODEL_NAME = gpt-3.5-turbo-config-ini

; Name of the model used for verification tasks.
VERIFICATION_MODEL_NAME = gpt-4-config-ini

; Name of the model used for embedding generation.
EMBEDDING_MODEL_NAME = text-embedding-ada-002-config-ini

[Application]
; Maximum number of retries for API calls.
MAX_RETRIES_API = 3

; Backoff factor for exponential backoff in API calls.
BACKOFF_FACTOR_API = 1.0
