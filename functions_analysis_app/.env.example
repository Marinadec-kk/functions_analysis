# .env.example

# AI_API_KEY: Your API key for accessing AI services.
# This key should be kept confidential and not committed to version control.
# Example: AI_API_KEY="sk-your_actual_api_key_here"
AI_API_KEY="your_ai_api_key_here"

# AI_API_BASE_URL: The base URL for your AI service.
# This can be changed if you are using a self-hosted model or a different endpoint.
# Example: AI_API_BASE_URL="https://api.openai.com/v1"
# AI_API_BASE_URL="http://localhost:8000/api"
